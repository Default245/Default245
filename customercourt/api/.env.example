DATABASE_URL="postgresql://postgres:postgres@localhost:5432/customercourt?schema=public"
# Local: host/port (docker-compose). Production: set REDIS_URL instead
# (e.g. Upstash rediss://... on Fly) — it takes precedence.
REDIS_HOST="localhost"
REDIS_PORT="6379"
ANTHROPIC_API_KEY="sk-ant-..."
PORT="3001"

# Stripe Financial Connections (bank linking + refund verification). Keep the
# real key in your environment/secret manager — never commit it.
STRIPE_SECRET_KEY=""
